generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Student {
  id          String   @id @default(cuid())
  tag         String   @unique
  name        String
  department  String
  gpa         Float    @default(0)
  certificate String?
  degree      String   @default("Diploma")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("students")
}
