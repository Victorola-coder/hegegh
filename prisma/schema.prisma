generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") 
  directUrl = env("POSTGRES_URL_NON_POOLING") 
}

model Student {
  id          String   @id @default(cuid())
  tag         String   @unique
  name        String
  department  String
  gpa         Float    @default(0)
  certificate String?
  degree      String   @default("Diploma")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("students")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waitlist")
}
